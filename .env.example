# Copy this file to ".env" and fill it in.
# Gmail: turn on 2-Step Verification, then create an "App Password" and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourbooth@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Our Photobooth <yourbooth@gmail.com>"
MAIL_SUBJECT=Your photobooth pictures!
